# Example settings. Do not commit real credentials or use this local server on the public internet.
# Register a Web application in Google Cloud OAuth clients and authorize your exact localhost origin.
BLORP_GOOGLE_CLIENT_ID=
# Public instructions displayed to users only after they request a manual payment.
# Don't paste secret banking credentials here.
BLORP_PAYMENT_INSTRUCTIONS=
# Optional HTTPS hosted payment links from YOUR payment provider account. No automatic verification.
BLORP_CHECKOUT_URL_BUILDER_MONTHLY=
BLORP_CHECKOUT_URL_BUILDER_ANNUAL=
BLORP_CHECKOUT_URL_STUDIO_MONTHLY=
BLORP_CHECKOUT_URL_STUDIO_ANNUAL=

# Public client ID (not secret) for the Google OAuth "Desktop app" client.
# Separate from BLORP_GOOGLE_CLIENT_ID (Web client). Use a Google Cloud Desktop OAuth client.
BLORP_GOOGLE_DESKTOP_CLIENT_ID=
