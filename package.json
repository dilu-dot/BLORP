{
  "name": "blorp-ai-customer-desktop",
  "private": true,
  "version": "0.5.6",
  "description": "Blorp AI Windows customer cloud signup and membership preview",
  "main": "desktop/main.js",
  "scripts": {
    "desktop:start": "electron .",
    "desktop:check": "node --check desktop/main.js && node --check desktop/cloud-auth.js && node --check public/assets/cloud-desktop.js && node desktop/check.js",
    "desktop:build": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ai.blorp.customer",
    "productName": "Blorp AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.js",
      "desktop/cloud-auth.js",
      "desktop/google-oauth.js",
      "desktop/preload.js",
      "desktop/owner-exclusion.txt",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "desktop/blorp.ico"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.0"
  }
}
